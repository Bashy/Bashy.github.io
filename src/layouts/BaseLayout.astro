---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  minimalBrand?: boolean;
  lang?: string;
}

const {
  title,
  description = 'Lead Dev NetDevOps specializing in Python and Cisco NSO network automation.',
  minimalBrand = false,
  lang = 'en',
} = Astro.props;

const pageTitle = `${title} · benjamin phạm-bachelart`;
const ogImage = new URL('/favicon.png', Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href="/">
          {minimalBrand ? (
            <Fragment>benjamin.pham.pm</Fragment>
          ) : (
            <Fragment>benjamin phạm-bachelart<span class="cursor">_</span></Fragment>
          )}
        </a>
        <div class="links">
          <a href="/">Home</a>
          <a href="/experience/">Experience</a>
          <a href="/blog/">Blog</a>

        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <a href="https://www.linkedin.com/in/bashy/" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn
        </a>
      </p>
    </footer>
  </body>
</html>
