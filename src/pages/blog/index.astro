---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { compareLang, formatDate, langFlags, langLabels, toLang } from '../../i18n';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const langs = [...new Set(posts.map((post) => toLang(post.data.lang)))].sort(compareLang);
---

<BaseLayout title="Blog">
  <h1>Blog</h1>

  {langs.length > 1 && (
    <div class="lang-filter" role="group" aria-label="Filter posts by language">
      <button type="button" class="lang-filter-btn" data-lang="all" aria-pressed="true">All</button>
      {langs.map((lang) => (
        <button type="button" class="lang-filter-btn" data-lang={lang} aria-pressed="false">
          {langFlags[lang]} {langLabels[lang]}
        </button>
      ))}
    </div>
  )}

  <ul class="post-list">
    {posts.map((post) => (
      <li data-lang={toLang(post.data.lang)} lang={toLang(post.data.lang)}>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <span class="post-date">
          <span aria-hidden="true">{langFlags[toLang(post.data.lang)]}</span>
          {formatDate(post.data.pubDate, toLang(post.data.lang))}
        </span>
        {post.data.description && <p>{post.data.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.lang-filter-btn');
  const items = document.querySelectorAll<HTMLLIElement>('.post-list li');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const lang = button.dataset.lang;

      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      items.forEach((item) => {
        item.hidden = lang !== 'all' && item.dataset.lang !== lang;
      });
    });
  });
</script>
